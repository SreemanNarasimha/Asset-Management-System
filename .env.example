# =========================================
# MAMS Environment Configuration Example
# =========================================
# Copy this file to .env and configure the 
# values for your environment.
# DO NOT commit real secrets to version control!

# -----------------------------------------
# Database Variables (Docker Compose)
# -----------------------------------------
MYSQL_ROOT_PASSWORD=change_this_to_a_secure_root_password
MYSQL_DATABASE=mams
MYSQL_USER=mams_app
MYSQL_PASSWORD=change_this_to_a_secure_app_password

# -----------------------------------------
# Backend Variables (Spring Boot)
# -----------------------------------------
DB_URL=jdbc:mysql://localhost:3306/mams?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=mams_app
DB_PASSWORD=change_this_to_a_secure_app_password
# Ensure this is a securely generated 256-bit string minimum
JWT_SECRET=generate_a_secure_random_string_here_for_jwt
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------
# Frontend Variables (Vite/React)
# -----------------------------------------
# This variable is public and safe to expose in the frontend build.
VITE_API_BASE=http://localhost:8080/api
